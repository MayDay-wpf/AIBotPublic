@{
    ViewData["Title"] = "素材库（Material Library）";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/system/js/filesystem/style.min.css" rel="stylesheet" />
<script src="/system/js/masonry.pkgd.min.js"></script>
<div class="header">
    <div class="header-left">
        <a id="menuMain" href="" class="burger-menu">
            <i data-feather="menu">
            </i>
        </a>
        <a id="menuBack" href="" class="burger-menu d-none">
            <i data-feather="arrow-left">
            </i>
        </a>
        <button type="button" class="btn btn-info clearRole" style="margin-left:10px;color:white"
                onclick="uploadFiles()">
            <i data-feather="file"></i> 文件上传
        </button>
        @* <a href="#" class="header-help-link" onclick="DALLinfo()">
        <i data-feather="help-circle">
        </i>
        </a> *@
    </div>
</div>
<div class="content-body" style="margin-top:10px;">
    <div class="content-header">
        <div>
            <h4 class="content-title content-title-sm">
                <b style="background-image: linear-gradient(to right, rgb(255,103,43), rgb(223,15,105));
    -webkit-background-clip: text;
    color: transparent;">素材库</b>
            </h4>
            <span>您可以在这里存储文本类型文件🗄️</span>
            <p></p>
        </div>
    </div>
    <div class="content-main text-center">
        <div class="header-search mb-4">
            <i data-feather="search"></i>
            <input type="search" class="form-control" placeholder="输入文件名搜索文件，回车搜索" id="searchKey"
                   style="width: 100%;">
        </div>
        <div id="file-table-container">
            <!-- Table will be rendered here -->
        </div>
        <div id="pagination-container" class="d-flex justify-content-center mt-3">
            <!-- Pagination will be rendered here -->
        </div>
    </div>
</div>
<script src="~/system/js/filesystem/jstree.min.js"></script>
<script src="~/system/js/filesystem/fileslib.js?v1.0.2"></script>