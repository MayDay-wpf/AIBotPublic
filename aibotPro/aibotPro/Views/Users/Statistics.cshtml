@{
    ViewData["Title"] = "统计 (Statistics)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/system/chart/daterangepicker.css" rel="stylesheet" />
<script src="~/system/chart/echarts.min.js"></script>
<style>
    .priceInfoUsers {
        border: 2px solid deepskyblue;
        padding: 5px;
        border-radius: 5px;
        margin-bottom: 10px;
    }

    .priceInfoVips {
        border: 2px solid gold;
        padding: 5px;
        border-radius: 5px;
        margin-bottom: 10px;
    }

    .priceInfoSVips {
        border: 2px solid orangered;
        padding: 5px;
        border-radius: 5px;
        margin-bottom: 10px;
    }



    .heatmap-container {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch; /* iOS平滑滚动 */
    }

    .contribution-box {
        width: 10px;
        height: 10px;
        margin: 1px;
        border-radius: 2px;
        cursor: pointer;
    }

    .contribution-level {
        width: 10px;
        height: 10px;
        margin: 0 1px;
        border-radius: 2px;
    }

    .month-label {
        font-size: 12px;
        color: #767676;
        text-align: center;
        padding: 0;
    }

    .day-label {
        font-size: 12px;
        color: #767676;
        height: 12px;
        line-height: 12px;
        padding-right: 4px;
        margin: 0;
    }

    /* 移动端适配 */
    @@media (max-width: 768px) {
        .contribution-box {
            width: 6px; /* 更小的方块尺寸 */
            height: 6px;
            margin: 0.5px; /* 更小的间距 */
        }

        .contribution-level {
            width: 6px;
            height: 6px;
            margin: 0 0.5px;
        }

        .month-label {
            font-size: 9px; /* 更小的字体 */
            padding: 0;
            margin: 0;
        }

        .day-label {
            font-size: 9px;
            height: 8px;
            line-height: 8px;
            padding-right: 2px; /* 减小右内边距 */
            margin: 0;
        }

        #heatmap {
            min-width: 400px; /* 减小最小宽度 */
            padding: 0; /* 移除内边距 */
        }

        .container {
            padding: 0 5px; /* 减小容器内边距 */
        }
    }

    /* 更小屏幕的适配 */
    @@media (max-width: 375px) {
        .contribution-box {
            width: 5px;
            height: 5px;
            margin: 0.5px;
        }

        .contribution-level {
            width: 5px;
            height: 5px;
        }

        .month-label {
            font-size: 8px;
        }

        .day-label {
            font-size: 8px;
        }

        #heatmap {
            min-width: 350px;
        }
    }
</style>
<div class="header">
    <div class="header-left">
        <a id="menuMain" href="" class="burger-menu">
            <i data-feather="menu">
            </i>
        </a>
        <a id="menuBack" href="" class="burger-menu d-none">
            <i data-feather="arrow-left">
            </i>
        </a>
    </div>
</div>
<div class="content-body" style="margin-top:10px;">
    <div class="card">
        <div class="card-header">
            <h5>消耗分布</h5>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label for="nickname">筛选日期：</label>
                <input type="text" name="daterange" class="form-control datepicker" style="width:200px;" />
            </div>
            <label for="nickname">统计方式：</label>
            <select id="chartMode" class="form-control mb-3" style="width:200px;">
                <option value="money" selected>金额消耗统计</option>
                <option value="tokens">Token消耗统计</option>
            </select>
            <div class="form-group">
                <label>合计（<span id="unit">￥</span>）：</label>
                <input type="text" class="form-control" id="totalUse" readonly style="width:200px;background-color:ghostwhite" />
            </div>
            <div id="pieChart" style="width: 100%; height: 400px;"></div>
        </div>
    </div>
    <p></p>
    <div class="container mt-4">
        <div id="heatmap" class="mb-2 heatmap-container"></div>
        <div style="width: fit-content;" class="mx-auto">
            <!-- 居中对齐 -->
            <div class="d-flex justify-content-between align-items-center" style="margin: 0 10px;">
                <small class="text-muted" style="margin-right: 6px;">Less</small>
                <div class="d-flex">
                    <div class="contribution-level" style="background-color: #ebedf0;"></div>
                    <div class="contribution-level" style="background-color: #9be9a8;"></div>
                    <div class="contribution-level" style="background-color: #40c463;"></div>
                    <div class="contribution-level" style="background-color: #30a14e;"></div>
                    <div class="contribution-level" style="background-color: #216e39;"></div>
                </div>
                <small class="text-muted" style="margin-left: 6px;">More</small>
            </div>
        </div>
    </div>
    <p></p>
    <div class="card">
        <div class="card-header">
            <h5>消耗日志</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>模型名称(点击查看详情)</th>
                            <th>消耗金额</th>
                            <th>输入Token</th>
                            <th>输出Token</th>
                            <th>时间</th>
                            <th>错误计费</th>
                        </tr>
                    </thead>
                    <tbody id="logList">
                        <tr>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                        </tr>
                    </tbody>
                </table>
                <nav aria-label="Page navigation example">
                    <ul class="pagination">
                        <li class="page-item" id="first-page"><a class="page-link" href="#">首页</a></li>
                        <li class="page-item" id="previous-page"><a class="page-link" href="#">上一页</a></li>
                        <!-- 页码链接将在这里动态插入 -->
                        <li class="page-item" id="next-page"><a class="page-link" href="#">下一页</a></li>
                        <li class="page-item" id="last-page"><a class="page-link" href="#">尾页</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
    <p></p>
    <div class="card">
        <div class="card-header">
            <h5>撤销记录</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>消耗记录ID</th>
                            <th>消耗金额</th>
                            <th>原因</th>
                            <th>提交时间</th>
                            <th>处理进度</th>
                            <th>管理员回复</th>
                            <th>处理时间</th>
                        </tr>
                    </thead>
                    <tbody id="errList">
                        <tr>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                            <td>--</td>
                        </tr>
                    </tbody>
                </table>
                <nav aria-label="Page navigation example">
                    <ul class="pagination  errpagination">
                        <li class="page-item" id="first-page-err"><a class="page-link" href="#">首页</a></li>
                        <li class="page-item" id="previous-page-err"><a class="page-link" href="#">上一页</a></li>
                        <!-- 页码链接将在这里动态插入 -->
                        <li class="page-item" id="next-page-err"><a class="page-link" href="#">下一页</a></li>
                        <li class="page-item" id="last-page-err"><a class="page-link" href="#">尾页</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>
<script src="~/system/chart/moment.min.js"></script>
<script src="~/system/chart/daterangepicker.min.js"></script>
<script src="~/system/js/statistics.js?v1.0.2"></script>

