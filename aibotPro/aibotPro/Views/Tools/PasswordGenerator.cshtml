@{
    ViewData["Title"] = "密码生成器（Password Generator）";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/system/tools/passwordgenerator/css/passwordgenerator.css" rel="stylesheet"/>
<div class="header">
    <div class="header-left">
        <a id="menuMain" href="" class="burger-menu">
            <i data-feather="menu">
            </i>
        </a>
        <a id="menuBack" href="" class="burger-menu d-none">
            <i data-feather="arrow-left">
            </i>
        </a>
    </div>
</div>
<div class="content-body" style="margin-top:10px">
    <div class="content-header">
        <div>
            <h4 class="content-title content-title-sm">
                <b style="background-image: linear-gradient(to right, rgb(255,103,43), rgb(223,15,105));
    -webkit-background-clip: text;
    color: transparent;">密码生成器（Password Generator）</b>
            </h4>
            <span>生成安全可靠的密码，支持自定义长度、字符类型等选项</span>
        </div>
    </div>

    <!-- 密码生成设置 -->
    <div class="row mg-t-20">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="card-title"><i data-feather="settings"></i> 密码设置</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- 密码长度 -->
                        <div class="col-md-6">
                            <label for="passwordLength">密码长度: <span id="lengthValue">12</span></label>
                            <input type="range" class="form-control-range" id="passwordLength" min="6" max="128" value="12">
                            <small class="form-text text-muted">推荐长度：12-16位</small>
                        </div>

                        <!-- 密码数量 -->
                        <div class="col-md-6">
                            <label for="passwordCount">生成数量:</label>
                            <select class="form-control" id="passwordCount">
                                <option value="1">1个密码</option>
                                <option value="5">5个密码</option>
                                <option value="10" selected>10个密码</option>
                                <option value="20">20个密码</option>
                                <option value="50">50个密码</option>
                            </select>
                        </div>
                    </div>

                    <!-- 字符选项 -->
                    <div class="row mg-t-20">
                        <div class="col-md-12">
                            <h6>字符类型选择：</h6>
                            <div class="character-options">
                                <div class="option-item">
                                    <input type="checkbox" class="form-check-input" id="includeUppercase" checked>
                                    <label class="form-check-label" for="includeUppercase">
                                        <i data-feather="type"></i> 大写字母 (A-Z)
                                    </label>
                                    <span class="option-preview">ABCDEFGHIJKLMNOPQRSTUVWXYZ</span>
                                </div>

                                <div class="option-item">
                                    <input type="checkbox" class="form-check-input" id="includeLowercase" checked>
                                    <label class="form-check-label" for="includeLowercase">
                                        <i data-feather="type"></i> 小写字母 (a-z)
                                    </label>
                                    <span class="option-preview">abcdefghijklmnopqrstuvwxyz</span>
                                </div>

                                <div class="option-item">
                                    <input type="checkbox" class="form-check-input" id="includeNumbers" checked>
                                    <label class="form-check-label" for="includeNumbers">
                                        <i data-feather="hash"></i> 数字 (0-9)
                                    </label>
                                    <span class="option-preview">0123456789</span>
                                </div>

                                <div class="option-item">
                                    <input type="checkbox" class="form-check-input" id="includeSymbols" checked>
                                    <label class="form-check-label" for="includeSymbols">
                                        <i data-feather="at-sign"></i> 特殊字符
                                    </label>
                                    <span class="option-preview">!@@#$%^&*()_+-=[]{}|;:,.&lt;&gt;?"'`~</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 高级选项 -->
                    <div class="row mg-t-20">
                        <div class="col-md-12">
                            <h6>高级选项：</h6>
                            <div class="advanced-options">
                                <div class="option-item">
                                    <input type="checkbox" class="form-check-input" id="excludeSimilar">
                                    <label class="form-check-label" for="excludeSimilar">
                                        <i data-feather="eye-off"></i> 排除相似字符 (0, O, l, 1, I)
                                    </label>
                                </div>

                                <div class="option-item">
                                    <input type="checkbox" class="form-check-input" id="excludeAmbiguous">
                                    <label class="form-check-label" for="excludeAmbiguous">
                                        <i data-feather="shield"></i> 排除歧义字符 ({}, [], (), &lt;&gt;, ", ', `, ~)
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 生成按钮 -->
                    <div class="row mg-t-20">
                        <div class="col-md-12 text-center">
                            <button type="button" class="btn btn-primary btn-lg" id="generateBtn" onclick="generatePasswords()">
                                <i data-feather="key"></i> 生成密码
                            </button>
                            <button type="button" class="btn btn-secondary btn-lg mg-l-10" id="clearBtn" onclick="clearPasswords()">
                                <i data-feather="trash-2"></i> 清空
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 生成结果 -->
    <div class="row mg-t-20" id="resultsContainer" style="display: none;">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="card-title"><i data-feather="list"></i> 生成的密码</h6>
                    <div>
                        <button type="button" class="btn btn-success btn-sm" onclick="copyAllPasswords()">
                            <i data-feather="copy"></i> 复制全部
                        </button>
                        <button type="button" class="btn btn-info btn-sm" onclick="downloadPasswords()">
                            <i data-feather="download"></i> 下载
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="passwordResults" class="password-results"></div>

                    <!-- 密码强度统计 -->
                    <div id="strengthStats" class="strength-stats mg-t-20" style="display: none;">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="stat-card">
                                    <div class="stat-number" id="totalChars">0</div>
                                    <div class="stat-label">总字符集</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card">
                                    <div class="stat-number" id="entropy">0</div>
                                    <div class="stat-label">熵值(bits)</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card">
                                    <div class="stat-number" id="combinations">0</div>
                                    <div class="stat-label">组合数量</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="stat-card">
                                    <div class="stat-number strength-good" id="strengthLevel">强</div>
                                    <div class="stat-label">安全等级</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/system/tools/passwordgenerator/js/passwordgenerator.js"></script>